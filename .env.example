# ==============================================================================
# UCHealth - CQO (Clinical Quality Optimization) Environment Configuration
# Copy this file to .env and replace placeholders with your actual secrets.
# NEVER commit .env into source control!
# ==============================================================================

# --- Tenant Details ---
TENANT_ID=CL_UCH_001
TENANT_NAME=UC Health
TENANT_SLUG=uc_health

# --- OpenAI LLM Configuration (Multi-Agent Swarm) ---
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# --- Snowflake Data Warehouse Credentials ---
SNOWFLAKE_USER=YOUR_SNOWFLAKE_SERVICE_USER
SNOWFLAKE_ACCOUNT=your_org_account.region
SNOWFLAKE_ROLE=YOUR_ROLE
SNOWFLAKE_WAREHOUSE=YOUR_WH
SNOWFLAKE_DATABASE=YOUR_DB
SNOWFLAKE_SCHEMA=PUBLIC
PRIVATE_KEY_PATH=/app/lambda_migration._rsa_key.p8
PRIVATE_KEY_PASSPHRASE=none
SNOWFLAKE_PAT=
SNOWFLAKE_URL=

# --- GitHub Repository Credentials ---
GITHUB_PAT=ghp_your_personal_access_token_here
GITHUB_URL=https://github.com/supplycopia-nirmal/uc_health_clinical.git

# --- Dashboard Local Fallback Authentication ---
APP_USERNAME=admin
APP_PASSWORD=choose_a_strong_password_here

# --- Jira Service Desk Integration ---
JIRA_URL=https://your-company.atlassian.net
JIRA_SPACE_ID=UCH
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_DEFAULT_ASSIGNEE=lead_developer@supplycopia.com

# --- Microsoft Entra ID (Azure AD) SAML 2.0 / SSO Configuration ---
# (To be filled once DevOps provisions the Enterprise Application)
SAML_ENABLED=true
SAML_SP_ENTITY_ID=https://uchealth-clinical.supplycopia.com
SAML_SP_ACS_URL=https://uchealth-clinical.supplycopia.com/saml/acs
SAML_IDP_ENTITY_ID=https://sts.windows.net/<YOUR_TENANT_ID>/
SAML_IDP_SSO_URL=https://login.microsoftonline.com/<YOUR_TENANT_ID>/saml2
SAML_IDP_SLO_URL=https://login.microsoftonline.com/<YOUR_TENANT_ID>/saml2
SAML_IDP_X509_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
MICROSOFT_TENANT_ID=your-azure-tenant-id-guid

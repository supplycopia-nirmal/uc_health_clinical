*.pyc
*.pyo
*.pyd

# Operating system
.DS_Store
Thumbs.db

# Large raw data files (mount as volumes if needed)
data/*.csv
data/*.parquet
data/jira_attachments/*
!data/jira_attachments/.gitkeep
